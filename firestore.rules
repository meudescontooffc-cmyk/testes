rules_version = '2';

// ============================================================
// Regras de segurança — Granja M Santos
// Cole isto em: Firebase Console > Firestore Database > aba "Regras"
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin' && myProfile().active == true;
    }

    // Permite a criação da PRIMEIRA conta (dono), antes de existir
    // qualquer usuário no sistema. Depois que o marco "meta/bootstrap"
    // é criado pelo app, essa porta se fecha automaticamente.
    function isBootstrapping() {
      return !exists(/databases/$(database)/documents/meta/bootstrap);
    }

    match /meta/bootstrap {
      allow get: if true;
      allow create: if isBootstrapping();
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      // Caso 1: a PRÓPRIA pessoa cria seu perfil — só acontece no cadastro
      // do primeiro dono, na tela de "Configuração inicial".
      // Caso 2: um admin já logado cria o perfil de outra pessoa — é o que
      // acontece no botão "+ Novo usuário" (quem grava é o dono, não o
      // novo funcionário, por isso precisa dessa segunda condição).
      allow create: if isSignedIn() && (
        (request.auth.uid == uid && isBootstrapping()) ||
        isAdmin()
      );
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      // Qualquer funcionário pode ATUALIZAR o estoque, mas somente o
      // campo "sold" (baixa automática ao vender). Tudo o mais (preço,
      // nome, estoque mínimo, campo "received") é só do dono.
      allow update: if isAdmin() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold']));
      allow create, delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /movements/{movementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /dailyNotes/{day} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /atendimentos/{atendimentoId} {
      allow read, update, delete: if isSignedIn() &&
        (resource.data.employeeUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.employeeUid == request.auth.uid;
    }
  }
}
